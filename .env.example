# ---------------------------------------------------------------------------
# shared-postgres — environment variables
# Copy this file to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace to deploy into (must exist or deploy.sh will create it)
HOMELAB_NAMESPACE=homelab

# ── Postgres image ───────────────────────────────────────────────────────────
# Image and tag from Docker Hub. Bump POSTGRES_TAG for minor upgrades.
# WARNING: Major version upgrades (e.g. 16→17) require pg_upgrade or dump+restore.
# See docs/MAINTENANCE.md#upgrade-postgres-major-version
POSTGRES_IMAGE=postgres
POSTGRES_TAG=16

# ── Superuser password ───────────────────────────────────────────────────────
# The built-in 'postgres' superuser. Used only for maintenance (create DB, \du, etc).
# Generate a strong one:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# ── Per-app bootstrap credentials (init.sh ConfigMap only) ───────────────────
# As of 2026-06-01, each app owns its own <app>-postgres-secret and rotates
# its own DB password via its own deploy.sh. The vars below are ONLY consumed
# by the init.sh ConfigMap on first pod start to bootstrap each app's user.
# After first start they have no effect — apps own their own creds.
# shared-postgres-secret no longer carries these values.

# Chores app (kids' chore tracker)
KIDSTASKS_PASSWORD=change-me

# Email matrix app
EMAILMATRIX_PASSWORD=change-me

# Reminders app
REMINDERS_PASSWORD=change-me
